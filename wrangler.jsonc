{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Temp name for building/testing. Renamed to "portfolio-site" (with the
  // git connection repointed to this repo) only at the final cutover —
  // see .impeccable notes / ask before doing that step.
  "name": "portfolio-site-preview",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.txt"], "fallthrough": true }
  ],
  "observability": {
    "enabled": true
  }
}
